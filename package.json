{
  "name": "rateguard-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.6.2",
  "workspaces": [
    "backend",
    "frontend",
    "packages/*",
    "rateguard-node"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "changeset": "changeset",
    "version": "changeset version",
    "release:stable": "node scripts/release.mjs stable",
    "release:beta": "node scripts/release.mjs beta",
    "release:next": "node scripts/release.mjs next",
    "release:nightly": "node scripts/release.mjs nightly",
    "benchmark": "node benchmarks/run.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@changesets/cli": "^2.29.6",
    "@types/node": "^24.11.2",
    "eslint": "^9.35.0",
    "globals": "^16.5.0",
    "prettier": "^3.6.2",
    "typescript-eslint": "^8.46.2",
    "typescript": "^5.9.2"
  },
  "overrides": {
    "archiver": "7.0.1"
  }
}
